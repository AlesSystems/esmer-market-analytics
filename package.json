{
  "name": "esmer-market-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Esmer Market çevrimdışı analiz uygulaması",
  "author": "Ales Systems",
  "license": "UNLICENSED",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "install-electron && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:desktop",
    "package:local": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 && node scripts/verify-package.mjs release/win-unpacked/resources/app.asar"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "read-excel-file": "9.3.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.alessystems.esmermarketanalytics",
    "productName": "Esmer Market Analytics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!dist/licences/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "dist/licences",
        "to": "licences"
      }
    ]
  },
  "type": "module"
}
