{
  "name": "esmer-market-analytics",
  "version": "1.0.1",
  "private": true,
  "description": "Esmer Market çevrimdışı analiz uygulaması",
  "author": "Ales Systems",
  "license": "UNLICENSED",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "install-electron && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:desktop",
    "synthetic-sql": "node tools/synthetic-sql.ts",
    "prepare:month": "node tools/prepare-month.ts",
    "package:local": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 && node scripts/verify-package.mjs release/win-unpacked/resources/app.asar && node tools/release-inventory.ts release/win-unpacked release/release-inventory.json && node scripts/verify-distributions.mjs",
    "package:mac": "npm run build && electron-builder --mac zip --arm64 && node scripts/verify-package.mjs \"release/mac-arm64/Esmer Market Analytics.app/Contents/Resources/app.asar\" && node tools/release-inventory.ts \"release/mac-arm64/Esmer Market Analytics.app\" release/mac-release-inventory.json mac"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxen": "11.1.1",
    "tailwind-merge": "3.7.0",
    "tedious": "20.3.8",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "happy-dom": "20.0.11",
    "postcss": "8.5.28",
    "read-excel-file": "9.3.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.alessystems.esmermarketanalytics",
    "productName": "Esmer Market Analytics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!dist/licences/**/*",
      "!node_modules/@azure/msal-node/src/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "nsis": {
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "mac": {
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "dist/licences",
        "to": "licences"
      }
    ]
  },
  "type": "module"
}
