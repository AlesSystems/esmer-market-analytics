  "narrative": {
    "northStar": "The Working Desk",
    "overview": "A deep navy navigation rail holds the period, data cutoff and operations beside white financial sheets on a cool gray canvas. The interface is compact and direct: a Turkish label explains each figure, tabular numerals support comparison, and visible rules separate ledger rows.\n\nBlue identifies actions and the selected path. Material uncertainty stays beside the affected figure; fuller methods and source records open through labelled disclosures. This records the implemented Option B world, selected by the user, rather than every historical style still present in the stylesheet.",
    "keyCharacteristics": [
      "Navy navigation and white financial sheets.",
      "Large primary amounts, compact ledger rows and tabular numerals.",
      "Turkish labels and explicit evidence states.",
      "Modest corners, visible dividers and restrained overlay depth."
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Blue identifies a path or a control; it does not certify financial performance.",
        "section": "colors"
      },
      {
        "name": "The Comparable Figures Rule",
        "body": "Use tabular numerals for amounts, totals and tables; align numeric table columns to the right and retain their units.",
        "section": "typography"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Use shadow to explain overlap; ordinary financial sheets keep borders and no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the period, actual cutoff and synthetic identity readable alongside navigation.",
      "**Do** pair financial color with signs, labels and accessible textual amounts.",
      "**Do** preserve explicit unavailable and estimated states beside the affected figures.",
      "**Do** use visible borders, tabular numerals and aligned rows to make comparisons easy.",
      "**Do** retain labelled keyboard focus and the implemented forced-colors treatment."
    ],
    "donts": [
      "**Don't** use blue as a gain signal or treat an estimate as verified profit.",
      "**Don't** replace missing financial evidence with a zero.",
      "**Don't** add gradients, glass, glow or color-only status.",
      "**Don't** turn every ledger row into a separate raised card.",
      "**Don't** hide period, cutoff or financial caveats to make a narrow layout fit."
    ]
  }
}
